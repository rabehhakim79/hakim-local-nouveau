@echo off
chcp 65001 > nul
title نظام إدارة المحلات ونقاط البيع
echo.
echo ========================================================
echo       جاري تشغيل نظام إدارة المحلات ونقاط البيع
echo ========================================================
echo.

if not exist node_modules (
    echo [1/2] تثبيت ملفات ومكتبات التشغيل لأول مرة... يرجى الانتظار...
    call npm install
    echo تم التثبيت بنجاح!
    echo.
)

echo [2/2] تشغيل خادم البرنامج المحلي...
echo.
echo ========================================================
echo  البرنامج سيعمل الآن على الرابط: http://localhost:3000
echo  يرجى عدم إغلاق هذه النافذة أثناء استخدام البرنامج.
echo ========================================================
echo.

start http://localhost:3000
call npm run dev
pause
