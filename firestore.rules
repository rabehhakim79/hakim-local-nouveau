rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Online orders: anyone can submit orders from mobile/storefront, everyone can read/update their statuses
    match /online_orders/{orderId} {
      allow read, write: if true;
    }

    // Products: storefront visitors can read products, admin can create and update products
    match /products/{productId} {
      allow read, write: if true;
    }

    // Store settings: readable by storefront (name, phone, delivery fee), writable by admin
    match /store_settings/{settingId} {
      allow read, write: if true;
    }

    // Customers and Invoices: allow read & write
    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }
  }
}
