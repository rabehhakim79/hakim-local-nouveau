{
  "rules": "firestore.rules",
  "entities": {
    "products": {
      "title": "Products",
      "description": "Products inventory for POS and Online Store",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unit": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "sellingPrice", "stock"]
    },
    "online_orders": {
      "title": "Online Orders",
      "description": "Orders submitted by customers via mobile/web storefront",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "deliveryType": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "items", "total", "status"]
    },
    "store_settings": {
      "title": "Store Settings",
      "description": "Global store configuration and license details",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "enableOnlineStore": { "type": "boolean" }
      },
      "required": ["storeName"]
    },
    "customers": {
      "title": "Customers",
      "description": "Store customers and their debt records",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "totalDebt": { "type": "number" },
        "totalPurchases": { "type": "number" }
      },
      "required": ["name", "phone"]
    },
    "invoices": {
      "title": "Sale Invoices",
      "description": "Completed POS and sales transactions",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "date": { "type": "string" },
        "grandTotal": { "type": "number" },
        "profit": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["invoiceNumber", "date", "grandTotal", "status"]
    }
  }
}
